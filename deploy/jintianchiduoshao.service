[Unit]
Description=Jintianchiduoshao public meal planner
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jintianchiduoshao
Group=jintianchiduoshao
WorkingDirectory=/opt/jintianchiduoshao
Environment=NODE_ENV=production
Environment=PORT=18085
EnvironmentFile=/etc/jintianchiduoshao/app.env
ExecStart=/opt/jintianchiduoshao/runtime/bin/node --max-old-space-size=128 /opt/jintianchiduoshao/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=192M
CPUQuota=50%
TasksMax=64
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jintianchiduoshao

[Install]
WantedBy=multi-user.target
